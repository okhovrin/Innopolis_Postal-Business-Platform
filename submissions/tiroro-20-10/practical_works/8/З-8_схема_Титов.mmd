flowchart TB
    C(["Клиент<br/>экран или API"])
    subgraph IN["ТОЧКА ПРИЁМА"]
        GW["BFF (экран) / API Gateway (API)"]
    end
    subgraph FP["СЕРВИС РАЗБОРА ФАЙЛОВ"]
        CHK["Проверка задания (до разбора)<br/>не более 1000 строк, формат файла"]
        ST[("Хранилище задания<br/>БД разбора: id, статус, 3 множества<br/>+ файловое хранилище: сам файл")]
        WP["Воркер разбора<br/>опрос: статус задания = принято"]
        V1["Уровень 1 -- формальный<br/>ПО ОДНОЙ СТРОКЕ"]
    end
    subgraph RS["REST API → СЕРВИС ВОЗВРАТОВ"]
        V2["Уровень 2 -- бизнес-правила<br/>ПАКЕТОМ: все валидные строки одним вызовом"]
        TX[("Одна транзакция БД возвратов:<br/>заявки «Черновик» + задачи outbox<br/>«оформить заявку N»")]
        WO["Воркер «Оформление возвратов»<br/>ПО ОДНОЙ ЗАЯВКЕ<br/>опрос: время исполнения ≤ сейчас"]
    end
    EXT["Тарификатор → Онлайн Баланс (удержание)<br/>→ ШПИ возврата"]
    R["Результат: три множества<br/>обработано / отклонено / требует вмешательства"]

    C -- "файл / список ШПИ" --> GW --> CHK
    CHK -- "больше 1000 строк:<br/>«разделите файл»" --> C
    CHK -- "принято" --> ST
    ST -. "СРАЗУ: 202 + id задания" .-> C
    ST --> WP --> V1
    V1 -- "ошибка формата --<br/>требует вмешательства" --> R
    V1 -- "валидные строки" --> V2
    V2 -- "не принадлежит, вручено,<br/>срок истёк -- отклонено" --> R
    V2 --> TX
    TX -. "ОТЛОЖЕННАЯ ОПЕРАЦИЯ" .-> WO
    WO --> EXT
    WO -- "Черновик → Оформлена<br/>обработано" --> R
    WO -- "нет денег / сбой после повторов --<br/>требует вмешательства" --> R
    C -. "опрос статуса каждые 10 с<br/>(API -- не чаще 30 с) + уведомление" .-> R

    classDef now fill:#E8F5E9,stroke:#2E7D32,color:#1B5E20
    classDef v fill:#FFF3E0,stroke:#E07B00,color:#7A3E00
    classDef w fill:#E8EAF6,stroke:#2B3FC0,color:#1F2A6B
    class V1,V2,CHK v
    class WP,WO w
